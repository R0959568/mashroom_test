# Copy to .env next to docker-compose.yml and fill in. .env is git-ignored; never paste these values in chat or tickets.

# Host
NETBIRD_IP=100.x.y.z            # "NetBird IP" from netbird status on the host; Postgres binds here and nowhere else
DATA_DIR=/data/citibike         # Parquet + landing zone; must be chmod 755 so Postgres can read it
BACKEND_PORT=8081               # loopback port nginx and cron talk to
IMAGE_TAG=dev                   # immutable tag of the image to run, e.g. 20260927b (never latest)
MUSHROOM_IMAGE_TAG=dev          # deployed with the app; maintained by the rollout script

# Postgres superuser (container-internal admin)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=citibike

# Read-write user for the ingest backend (created by postgres/init/01_roles.sh on first start)
INGEST_DB_USER=citibike_ingest
INGEST_DB_PASSWORD=change-me

# Shared secret for POST /api/ingest/runs (X-Admin-Token). Generate: openssl rand -hex 24
INGEST_ADMIN_TOKEN=change-me

# Ingest scope
INGEST_REGIONS=nyc              # nyc or nyc,jc
# Forecast API of notebook 11 (API Gateway in front of the SageMaker endpoints): the two values 11 wrote into the repo's .env.
# Empty = the forecast page answers 503, everything else works.
FORECAST_API_URL=
FORECAST_API_KEY=

# The overlay network of the host's nginx (docker network ls); the backend joins it as "citibike-backend" so that
# nginx can proxy the subdomain to it without a public port.
PROXY_NETWORK=henskens-app_henskens-network

INGEST_MIN_YEAR=2021

# Laptop only, with docker-compose.local.yml: CA bundle incl. a TLS-inspecting proxy's CA (see README)
# LOCAL_CA_BUNDLE=C:/path/to/data/certs/ca-bundle.pem
