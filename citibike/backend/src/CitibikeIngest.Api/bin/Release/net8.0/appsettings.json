{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ingest": {
    "BucketUrl": "https://s3.amazonaws.com/tripdata/",
    "DataDir": "/data/citibike",
    "SchemaVersion": "v2",
    "MinYear": 2021,
    "Regions": "nyc",
    "DefaultSince": "2021-01-01",
    "PythonExecutable": "python3",
    "ConverterScript": "/app/ingest/convert_zip.py"
  },
  "Calendar": {
    "ExporterScript": "/app/ingest/export_holidays.py"
  },
  "Mushroom": {
    "Url": "http://127.0.0.1:8001/"
  }
}
